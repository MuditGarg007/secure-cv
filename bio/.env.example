# Copy to bio/.env (never committed).
# Same value as BIO_INTERNAL_TOKEN in web/.env.local.
BIO_INTERNAL_TOKEN=change-me-shared-with-bio
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
BIO_TEMPLATE_KEY=
# 1 = no models; meta.fake ("pass" / "fail:<reason>") decides. Dev and tests only.
BIO_FAKE=0
# Optional, defaults to bio/models (filled by scripts/download_models.py)
# BIO_MODELS_DIR=
